  "tips": [
    {
      "title": "Je voudrais is how you order",
      "text": "Je voudrais means “I would like”. It is the polite way to ask for something: Je voudrais un café, s'il vous plaît.",
      "examples": []
    },
    {
      "title": "Le or la?",
      "text": "Every French noun is masculine or feminine. Le goes with masculine words (le pain) and la with feminine ones (la pomme). L' is used before a vowel (l'eau). Learn each word together with its le or la.",
      "examples": []
    }
  ],
