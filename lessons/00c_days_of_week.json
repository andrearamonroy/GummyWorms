  "tips": [
    {
      "title": "No capital letters",
      "text": "French days of the week are written with a small letter: lundi, not Lundi. The week starts on Monday, not Sunday.",
      "examples": []
    },
    {
      "title": "Add “le” for every week",
      "text": "Say le lundi to mean “on Mondays”, every Monday. Say lundi on its own for this coming Monday.",
      "examples": []
    }
  ],
