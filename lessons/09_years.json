  "tips": [
    {
      "title": "Years are plain numbers",
      "text": "In English we split a year in two, like “twenty twenty-four”. In French you say the whole number: two thousand twenty-four.",
      "examples": [
        {
          "parts": [
            {
              "fr": "deux mille",
              "en": "2000"
            },
            {
              "fr": "vingt-quatre",
              "en": "24"
            }
          ],
          "result": {
            "fr": "deux mille vingt-quatre",
            "en": "2024"
          }
        },
        {
          "parts": [
            {
              "fr": "deux mille",
              "en": "2000"
            },
            {
              "fr": "vingt-six",
              "en": "26"
            }
          ],
          "result": {
            "fr": "deux mille vingt-six",
            "en": "2026"
          }
        }
      ]
    },
    {
      "title": "Years skip the zero",
      "text": "2005 is deux mille cinq, never “two thousand zero five”. Just add the last digit.",
      "examples": [
        {
          "parts": [
            {
              "fr": "deux mille",
              "en": "2000"
            },
            {
              "fr": "cinq",
              "en": "5"
            }
          ],
          "result": {
            "fr": "deux mille cinq",
            "en": "2005"
          }
        },
        {
          "parts": [
            {
              "fr": "deux mille",
              "en": "2000"
            },
            {
              "fr": "six",
              "en": "6"
            }
          ],
          "result": {
            "fr": "deux mille six",
            "en": "2006"
          }
        }
      ]
    }
  ],
