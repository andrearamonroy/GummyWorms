  "tips": [
    {
      "title": "Tens plus units",
      "text": "Say the ten, then the unit, joined with a hyphen. The same pattern works all the way up to 69.",
      "examples": [
        {
          "parts": [
            {
              "fr": "vingt",
              "en": "20"
            },
            {
              "fr": "deux",
              "en": "2"
            }
          ],
          "result": {
            "fr": "vingt-deux",
            "en": "22"
          }
        },
        {
          "parts": [
            {
              "fr": "trente",
              "en": "30"
            },
            {
              "fr": "cinq",
              "en": "5"
            }
          ],
          "result": {
            "fr": "trente-cinq",
            "en": "35"
          }
        },
        {
          "parts": [
            {
              "fr": "quarante",
              "en": "40"
            },
            {
              "fr": "huit",
              "en": "8"
            }
          ],
          "result": {
            "fr": "quarante-huit",
            "en": "48"
          }
        }
      ]
    },
    {
      "title": "“et un” for 21, 31, 41, 51, 61",
      "text": "When the unit is 1, French adds “et”: vingt et un. For 2 to 9 it is just a hyphen, with no “et”.",
      "examples": [
        {
          "parts": [
            {
              "fr": "vingt",
              "en": "20"
            },
            {
              "fr": "un",
              "en": "1"
            }
          ],
          "result": {
            "fr": "vingt et un",
            "en": "21"
          }
        },
        {
          "parts": [
            {
              "fr": "trente",
              "en": "30"
            },
            {
              "fr": "un",
              "en": "1"
            }
          ],
          "result": {
            "fr": "trente et un",
            "en": "31"
          }
        },
        {
