  "tips": [
    {
      "title": "Tu or vous?",
      "text": "French has two ways to say “you”. Use tu with friends, family and children. Use vous with strangers, older people and in shops. When unsure, vous is always safe.",
      "examples": []
    },
    {
      "title": "Say merci beaucoup",
      "text": "Add beaucoup to make it stronger: merci beaucoup means “thank you very much”.",
      "examples": []
    }
  ],
