  "tips": [
    {
      "title": "Two hundred is two times a hundred",
      "text": "Say the number, then cent. From 200 up, cent takes an s: deux cents. For 100 on its own, just say cent, never “un cent”.",
      "examples": [
        {
          "op": "×",
          "parts": [
            {
              "fr": "deux",
              "en": "2"
            },
            {
              "fr": "cent",
              "en": "100"
            }
          ],
          "result": {
            "fr": "deux cents",
            "en": "200"
          }
        },
        {
          "op": "×",
          "parts": [
            {
              "fr": "trois",
              "en": "3"
            },
            {
              "fr": "cent",
              "en": "100"
            }
          ],
          "result": {
            "fr": "trois cents",
            "en": "300"
          }
        },
        {
          "op": "×",
          "parts": [
            {
              "fr": "neuf",
              "en": "9"
            },
            {
              "fr": "cent",
              "en": "100"
            }
          ],
          "result": {
            "fr": "neuf cents",
            "en": "900"
          }
        }
      ]
    },
    {
      "title": "The s drops when another number follows",
      "text": "As soon as another number comes after cents, the s disappears: deux cent un.",
      "examples": [
        {
          "parts": [
            {
              "fr": "deux cents",
              "en": "200"
            },
            {
              "fr": "un",
              "en": "1"
            }
          ],
          "result": {
            "fr": "deux cent un",
            "en": "201"
          }
        },
        {
          "parts": [
            {
              "fr": "deux cents",
              "en": "200"
            },
            {
              "fr": "cinquante",
              "en": "50"
            }
          ],
          "result": {
            "fr": "deux cent cinquante",
            "en": "250"
          }
        }
      ]
    },
    {
      "title": "Mille never takes an s",
      "text": "Mille is 1000, and it never changes: deux mille, trois mille.",
      "examples": [
        {
          "op": "×",
          "parts": [
            {
              "fr": "deux",
              "en": "2"
            },
            {
              "fr": "mille",
              "en": "1000"
            }
          ],
          "result": {
            "fr": "deux mille",
            "en": "2000"
          }
        }
      ]
    }
  ],
