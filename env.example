# Copy this file to .env and fill it in. Never commit .env to git.

# A long random string. Make one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# From Google Cloud Console > Google Auth platform > Clients
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- only on your live site ---
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# COOKIE_SECURE=1
# BEHIND_PROXY=1
